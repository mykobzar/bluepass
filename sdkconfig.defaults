# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Flash — adjust to actual module flash size (4MB or 8MB)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Bluetooth — NimBLE BLE-only, Central role only (connects TO keyboards, never acts as peripheral)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_SM_LEGACY=y

# USB — TinyUSB HID device via ESP32-S3 native USB OTG
# Managed component espressif/esp_tinyusb is declared in
# components/usb_hid_device/idf_component.yml
CONFIG_TINYUSB_HID_COUNT=2
# No HID buffer size here on purpose: CONFIG_TINYUSB_HID_BUFSIZE is not a real
# Kconfig symbol (the build warned "unknown kconfig symbol" and ignored it).
# CFG_TUD_HID_EP_BUFSIZE already defaults to 64 in tinyusb's hid_device.h, which
# is exactly what FIDO2/CTAP needs, so the line was requesting the default.

# WiFi — AMPDU not needed for low-throughput config traffic
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_AMPDU_RX_ENABLED=n

# SNTP — two servers; also accept server from DHCP
CONFIG_LWIP_SNTP_MAX_SERVERS=2
CONFIG_LWIP_DHCP_GET_NTP_SRV=y

# LwIP — tighter TCP buffers; web UI and webhooks don't need high throughput
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=5760
CONFIG_LWIP_TCP_WND_DEFAULT=5760
CONFIG_LWIP_TCP_RECVMBOX_SIZE=6

# HTTP server with WebSocket (key-log streaming tab)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_HTTPD_WS_SUPPORT=y

# mbedTLS — SHA-1 (needed for TOTP HMAC-SHA1) needs no option here: IDF defines
# MBEDTLS_SHA1_C unconditionally in mbedtls/port/include/mbedtls/esp_config.h.
# CONFIG_MBEDTLS_SHA1_C used to sit below and was silently ignored as an unknown
# Kconfig symbol — TOTP was never actually relying on it.
# IN_CONTENT_LEN must be >= the largest server TLS record: raw.githubusercontent.com's
# certificate chain is ~4127 B, so 4096 aborts the handshake (ESP_ERR_HTTP_CONNECT).
# DYNAMIC_BUFFER keeps 16384 only as a ceiling and allocates RX/TX to the actual record
# size (freed after use), so peak heap stays near the old 4 KB level — required because a
# static 16 KB buffer exhausts heap under concurrent WiFi+BLE+USB and even api.github.com
# then fails to connect. DYNAMIC_BUFFER auto-selects ASYMMETRIC_CONTENT_LEN.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y

# LWIP — the default 10 sockets is too few: WiFi + the web server (a browser opens
# several keep-alive connections + a persistent /ws WebSocket + per-second polling)
# starve the one outbound HTTPS socket the device needs to reach GitHub, giving
# ESP_ERR_ESP_TLS_CANNOT_CREATE_SOCKET on /api/ota/check and OTA. 16 is the max.
# The web server also uses lru_purge_enable so it recycles rather than hoarding sockets.
CONFIG_LWIP_MAX_SOCKETS=16

# MQTT
CONFIG_MQTT_TASK_STACK_SIZE=4096

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# Logging
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y

# FIDO2 — verbose per-packet logging off in production; enable for debugging
# CONFIG_FIDO2_DEBUG_LOG is not set

# BLE — verbose GAP/GATT event logging off in production; enable for debugging
# CONFIG_BLE_DEBUG_LOG is not set
